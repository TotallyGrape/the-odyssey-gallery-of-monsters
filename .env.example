# Server-side credentials only. Never prefix these with VITE_.
# Copy this file to .env and fill it in. See AI_SETUP.md.
GEMINI_API_KEY=
# A fast model keeps turns snappy, e.g. gemini-3.5-flash-lite
GEMINI_MODEL=
ELEVENLABS_API_KEY=
# The narrator's voice (an ID from your ElevenLabs voice library)
ELEVENLABS_VOICE_ID=
# e.g. eleven_v4_turbo
ELEVENLABS_MODEL_ID=
